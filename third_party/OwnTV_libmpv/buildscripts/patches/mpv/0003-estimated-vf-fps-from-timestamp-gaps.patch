+static int cmp_double(const void *a, const void *b)
+{
+    double x = *(const double *)a, y = *(const double *)b;
+    return x < y ? -1 : x > y;
+}
+
+// OwnTV: the mean of the recorded frame gaps that lie within rounding distance of
+// their median, or 0 with too few. The median drops outliers; averaging every
+// gap near it undoes 1 ms timestamp rounding (a 23.976 fps Matroska file mixes
+// 41 and 42 ms gaps, and cutting a fixed share off each end would bias that).
+double calc_trimmed_frame_gap(struct MPContext *mpctx)
+{
+    int num = mpctx->num_frame_gaps;
+    if (num < 8)
+        return 0;
+    double gaps[MP_ARRAY_SIZE(mpctx->frame_gaps)];
+    memcpy(gaps, mpctx->frame_gaps, num * sizeof(gaps[0]));
+    qsort(gaps, num, sizeof(gaps[0]), cmp_double);
+    double median = gaps[num / 2];
+    double tolerance = 0.001 * 3 + 0.0001; // as calculate_frame_duration
+    double total = 0;
+    int used = 0;
+    for (int n = 0; n < num; n++) {
+        if (fabs(gaps[n] - median) <= tolerance) {
+            total += gaps[n];
+            used++;
+        }
+    }
+    return used >= num / 2 ? total / used : 0;
+}
